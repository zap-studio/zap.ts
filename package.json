{
  "name": "zap.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @zap-ts/database run generate",
    "db:migrate": "pnpm --filter @zap-ts/database run migrate",
    "db:studio": "pnpm --filter @zap-ts/database run studio",
    "deploy": "pnpm --filter web run deploy",
    "dev": "pnpm --filter web run dev",
    "env:example": "pnpm --filter @zap-ts/environment run env:example",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "catalog:",
    "@zap-studio/oxlint": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.3+sha512.4d0847314b85338f031f6613850e3e6140fc8e41154b7e33ae10bab44bbdc11b274883a965d9890a04e49ad387124555ebda049ec278fd9ef902daeadb5a83e2"
}
