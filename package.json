{
  "name": "zap.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @zap-ts/database run generate",
    "db:migrate": "pnpm --filter @zap-ts/database run migrate",
    "db:studio": "pnpm --filter @zap-ts/database run studio",
    "deploy": "pnpm --filter web run deploy",
    "dev": "pnpm --filter web run dev",
    "env:example": "pnpm --filter @zap-ts/environment run env:example",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "catalog:",
    "@zap-studio/oxlint": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
